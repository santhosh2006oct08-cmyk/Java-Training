import java.util.*;
public class Main {
    public static void main(String[] args) {
        int[] arr = {10, 20, 30, 40, 10};
        int element = 10;

        int first = -1;
        int last = -1;

        for (int i = 0; i < arr.length; i++) {
            if (arr[i] == element) {
                if (first == -1) {
                    first = i;
                }
                last = i;
            }
        }

        if (first != -1) {
            System.out.println("First occurrence: " + first);
            System.out.println("Last occurrence: " + last);
        } else {
            System.out.println("Element not found");
        }
    }
}
