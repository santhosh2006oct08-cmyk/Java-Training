public class Grade {
    public static void main(String[] args) {

        int mark = 85;

        if (mark >= 90) {
            System.out.println("Grade A+");
        } else if (mark >= 80) {
            System.out.println("Grade A");
        } else if (mark >= 60) {
            System.out.println("Grade B");
        } else {
            System.out.println("Failed");
        }
    }
}
